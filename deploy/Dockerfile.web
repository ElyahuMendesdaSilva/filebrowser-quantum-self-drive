# Interface React (Self Drive) compilada e servida pelo nginx.
FROM node:22-alpine AS build
WORKDIR /app
COPY frontend-react/package.json frontend-react/package-lock.json ./
RUN npm install --no-audit --no-fund
COPY frontend-react/ ./
# URL da API vazia = mesma origem: o nginx encaminha /api e /public para o container "api".
ARG REACT_APP_FILEBROWSER_URL=""
ENV REACT_APP_FILEBROWSER_URL=$REACT_APP_FILEBROWSER_URL \
    CI=false
RUN npm run build

FROM nginx:alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build /usr/share/nginx/html
EXPOSE 80
